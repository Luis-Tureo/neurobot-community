# En desarrollo local, el panel escucha solo en localhost de forma predeterminada.
# En Azure App Service, si PANEL_HOST no está definido, usa 0.0.0.0 automáticamente.
PANEL_HOST=127.0.0.1
PANEL_PORT=3000

# Azure App Service define PORT automáticamente. No es necesario configurarlo manualmente allí.
# PORT=

# Directorio raíz de datos persistentes. En Azure App Service, si se omite,
# Neurobot usa automáticamente /home/neurobot.
DATA_ROOT=

# Si se omiten, se derivan desde DATA_ROOT:
#   <DATA_ROOT>/data/asistente.db
#   <DATA_ROOT>/data/whatsapp-session
DATABASE_PATH=./data/asistente.db
WHATSAPP_SESSION_PATH=./data/whatsapp-session
LOG_LEVEL=info

# Genere un valor aleatorio largo y único. Nunca use este ejemplo en producción.
ANONYMIZATION_SECRET=reemplace-por-un-secreto-aleatorio-de-al-menos-32-caracteres

# Opcional en el primer inicio. Si se omite, se muestra una contraseña temporal una sola vez.
PANEL_INITIAL_PASSWORD=
PANEL_SESSION_SECRET=reemplace-por-otro-secreto-aleatorio-de-al-menos-32-caracteres

MAX_MESSAGE_LENGTH=2000
MAX_RECONNECT_ATTEMPTS=8
MAX_RECONNECT_DELAY_SECONDS=300
DEVELOPMENT_MODE=false

# Opcional. Déjelo vacío para que Puppeteer use su navegador administrado.
CHROME_EXECUTABLE_PATH=

# Inteligencia artificial opcional. Cada instalación debe utilizar su propia clave; nunca la comparta.
# El modelo puede sobrescribirse definiendo GROQ_MODEL. El valor por defecto es llama-3.1-8b-instant.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
APP_ENCRYPTION_KEY=
