{
  "name": "asistente-comunidad-neurodivergente",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma local configurable de asistentes para grupos de WhatsApp.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24.18.1 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "preinstall": "node scripts/verify-runtime.mjs",
    "runtime:check": "node scripts/verify-runtime.mjs",
    "node:update:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/update-node-windows.ps1",
    "setup": "tsx scripts/setup.ts",
    "dev": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1",
    "dev:watch": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-dev.ps1 -Watch",
    "build": "npm run styles:build && tsc -p tsconfig.build.json",
    "styles:build": "npx @tailwindcss/cli -i ./src/admin/panel.css -o ./public/panel.css --minify",
    "styles:watch": "npx @tailwindcss/cli -i ./src/admin/panel.css -o ./public/panel.css --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run runtime:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "smoke": "tsx scripts/smoke.ts",
    "db:init": "tsx scripts/init-db.ts",
    "admin:reset": "tsx scripts/reset-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.1.0",
    "@fastify/static": "10.1.2",
    "better-sqlite3": "13.0.2",
    "dotenv": "17.4.2",
    "fastify": "5.11.0",
    "pino": "10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "1.34.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/cli": "^4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/qrcode-terminal": "0.12.2",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "puppeteer@24.38.0": true,
    "better-sqlite3@13.0.2": true
  }
}
